---
import "../styles/global.css";
import { company, navigation, supportInfo } from "../data/company";
interface Props { title: string; description?: string; path?: string; }
const { title, description = company.summary, path = "/" } = Astro.props;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta name="theme-color" content="#ffffff" /><link rel="icon" href="/favicon-sindoh.png" type="image/png" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <div class="topbar"><div class="container topbar__inner"><p>신도클라우드 복합기 렌탈·판매·유지보수 전문</p><a href={`tel:${company.phone.replaceAll("-", "")}`}>{company.phone}</a></div></div>
        <div class="container site-header__inner">
          <a class="site-logo" href="/"><img src="/logo-concepts/sindohcloud-circle-wordmark.svg" alt="sindohcloud 신도클라우드" width="236" height="55" /></a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
            <span class="nav-toggle__label">메뉴</span>
            <span class="nav-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <nav id="site-navigation" class="site-navigation" aria-label="주요 메뉴"><ul class="site-nav">{navigation.map((item) => <li><a class={item.href === path ? "is-active" : undefined} href={item.href}>{item.label}</a></li>)}</ul></nav>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div class="container site-footer__grid">
          <div class="site-footer__brand">
            <img src="/logo-concepts/sindohcloud-circle-wordmark.svg" alt="sindohcloud 신도클라우드" width="220" height="51" />
            <p>{company.tagline}</p>
          </div>
          <div class="site-footer__company">
            <p class="site-footer__title">회사정보</p>
            <p><span>회사명</span>{company.name}</p>
            <p><span>대표·사업자번호</span>{company.businessInfo.replace("사업자등록번호 ", "").replace(" / 대표 ", " · ")}</p>
            <p><span>주소</span>{company.address}</p>
          </div>
          <div class="site-footer__contact">
            <p class="site-footer__title">고객센터</p>
            <a class="site-footer__phone" href={`tel:${company.phone.replaceAll("-", "")}`}>{company.phone}</a>
            <p>{company.hours}</p>
            <p>{supportInfo.holidayNotice}</p>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </div>
        </div>
        <div class="container footer-copy">
          <p>© {new Date().getFullYear()} {company.name}. All Rights Reserved.</p>
          <p>기업용 복합기 렌탈·판매·유지보수 전문</p>
        </div>
      </footer>
    </div>
    <script>
      const header = document.querySelector<HTMLElement>(".site-header");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const navigation = document.querySelector<HTMLElement>(".site-navigation");

      const closeNavigation = () => {
        header?.classList.remove("is-menu-open");
        toggle?.setAttribute("aria-expanded", "false");
      };

      toggle?.addEventListener("click", () => {
        const isOpen = header?.classList.toggle("is-menu-open") ?? false;
        toggle.setAttribute("aria-expanded", String(isOpen));
      });

      navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeNavigation));
      window.addEventListener("resize", () => {
        if (window.innerWidth > 720) closeNavigation();
      });
    </script>
  </body>
</html>
