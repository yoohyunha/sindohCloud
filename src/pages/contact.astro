---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, supportInfo } from "../data/company";
---
<BaseLayout title={`${company.name} | 문의안내`} description="복합기 렌탈·구매·유지보수 상담 연락처" path="/contact">
  <section class="page-hero"><div class="container page-hero__inner"><p class="page-hero__eyebrow">CONTACT</p><h1>복합기 도입과 관리,<br />필요한 내용을 알려주세요.</h1><p>제품 선택부터 렌탈 조건, 설치와 유지보수까지 친절하게 안내해드립니다.</p></div></section>
  <section class="section"><div class="container info-ribbon">
    <div><p class="info-ribbon__label">Phone</p><strong><a href={`tel:${company.phone.replaceAll("-", "")}`}>{company.phone}</a></strong></div>
    <div><p class="info-ribbon__label">Email</p><strong><a href={`mailto:${company.email}`}>{company.email}</a></strong></div>
    <div><p class="info-ribbon__label">Hours</p><strong>{company.hours}</strong></div>
  </div></section>
  <section class="section"><div class="container two-column two-column--wide">
    <article class="detail-card"><h2>오시는 길</h2><p>{company.address}</p><a class="text-link" href={company.naverMapUrl} target="_blank" rel="noreferrer">네이버 지도에서 보기 →</a></article>
    <article class="detail-card"><h2>기타 안내</h2><p>팩스 {supportInfo.fax}</p><p>{supportInfo.holidayNotice}</p></article>
  </div></section>
</BaseLayout>
