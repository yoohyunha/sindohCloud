---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { company, supportInfo } from "../data/company";
---

<BaseLayout
  title={`${company.name} | 문의안내`}
  description="대표 연락처, 팩스, 주소, 운영시간과 계좌 정보를 한 번에 확인할 수 있습니다."
  path="/contact"
>
  <section class="page-hero page-hero--contact">
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">CONTACT</p>
      <h1>상담 연락처와 기본 안내 정보를 한눈에 확인할 수 있습니다.</h1>
      <p>전화, 팩스, 주소, 이용시간, 계좌 정보를 단순하고 빠르게 확인할 수 있도록 정리했습니다.</p>
    </div>
  </section>

  <section class="section">
    <div class="container two-column two-column--wide">
      <div>
        <SectionHeading eyebrow="Get in touch" title="" />
      </div>
      <div class="stack-list">
        <article class="detail-card">
          <h2>상담문의</h2>
          <p><a href={`tel:${company.phone.replaceAll("-", "")}`}>{company.phone}</a></p>
        </article>
        <article class="detail-card">
          <h2>팩스</h2>
          <p>{supportInfo.fax}</p>
        </article>
        <article class="detail-card">
          <h2>주소</h2>
          <p>{company.address}</p>
          <p><a class="text-link" href={company.naverMapUrl} target="_blank" rel="noreferrer">네이버 지도 열기</a></p>
        </article>
        <article class="detail-card">
          <h2>이용안내</h2>
          <p>상담시간: {company.hours}</p>
          <p>휴일안내: {supportInfo.holidayNotice}</p>
        </article>
        <article class="detail-card">
          <h2>입금계좌 안내</h2>
          <p>{supportInfo.bankName} {supportInfo.bankAccount}</p>
          <p>예금주명: {supportInfo.accountHolder}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container emphasis-panel">
      <div>
        <p class="emphasis-panel__eyebrow">Quick CTA</p>
      </div>
      <div class="emphasis-panel__actions">
        <a class="button" href="/products">제품목록 보기</a>
        <a class="button button--secondary" href="https://smartstore.naver.com/royaloa" target="_blank" rel="noreferrer">
          네이버 스토어 가기
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
