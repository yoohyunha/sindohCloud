---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import ContactPanel from "../components/ContactPanel.astro";
import HeroProductShowcase from "../components/HeroProductShowcase.astro";
import SidebarPanel from "../components/SidebarPanel.astro";
import { company } from "../data/company";
import { featuredProducts } from "../data/products";
---
<BaseLayout title={`${company.name} | 신도 복합기 렌탈·판매`} description={company.summary} path="/">
  <section class="hero hero--catalog"><div class="container hero-catalog">
    <SidebarPanel />
    <div class="hero-catalog__main">
      <div class="hero-catalog__intro">
        <p class="hero__eyebrow">SINDOH CLOUD</p>
        <h1>SindohCloud <br> 기업의 출력 환경을 설계하고, 설치 이후까지 책임집니다. </h1>
        <p class="hero__description">사무실에 맞는 신도 복합기와 관리 방식을 제안합니다.</p>
        <div class="hero__actions"><a class="button button--compare" href="/products">주력 모델 비교하기</a><a class="button button--ghost" href="/contact">상담 문의</a></div>
      </div>
      <HeroProductShowcase products={featuredProducts} />
    </div>
  </div></section>
  <section class="section"><div class="container">
    <SectionHeading eyebrow="MAIN MODELS" title="신도클라우드 주력 복합기" description="제품을 누르면 상세정보 페이지에서 먼저 사양과 특징을 확인할 수 있습니다." />
    <div class="product-grid">{featuredProducts.map((product) => <ProductCard product={product} />)}</div>
  </div></section>
  <section class="section section--soft"><div class="container">
    <SectionHeading eyebrow="WHY SINDOH CLOUD" title="도입부터 관리까지 한 번에" description={company.description} />
    <div class="feature-grid">{company.categories.map((category) => <article class="feature-card"><h3>{category.name}</h3><p>{category.description}</p></article>)}</div>
  </div></section>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>
