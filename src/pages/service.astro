---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { company } from "../data/company";
const services = [
  { title: "맞춤 렌탈", body: "초기 구매 부담을 줄이고 사용량과 설치 환경에 알맞은 복합기를 구성합니다." },
  { title: "정기 점검", body: "기기 상태와 소모품을 주기적으로 확인해 안정적인 업무 환경을 유지합니다." },
  { title: "소모품 관리", body: "토너와 주요 소모품의 교체 시기를 관리해 갑작스러운 출력 중단을 줄입니다." },
  { title: "장애 대응", body: "문제 발생 시 빠르게 상태를 확인하고 업무 공백을 줄이는 방향으로 대응합니다." }
];
---
<BaseLayout title={`${company.name} | 렌탈·유지보수`} description="신도리코 복합기 렌탈과 유지보수 안내" path="/service">
  <section class="page-hero"><div class="container page-hero__inner"><p class="page-hero__eyebrow">SERVICE</p><h1>복합기는 편하게 사용하고,<br />관리는 신도클라우드에 맡기세요.</h1><p>설치부터 정기 점검, 소모품 관리와 장애 대응까지 업무 흐름이 끊기지 않도록 돕습니다.</p></div></section>
  <section class="section"><div class="container feature-grid">{services.map((service) => <article class="feature-card"><h3>{service.title}</h3><p>{service.body}</p></article>)}</div></section>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>
