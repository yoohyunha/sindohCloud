---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductImageGallery from "../../../components/ProductImageGallery.astro";
import { company } from "../../../data/company";
import { supplies } from "../../../data/supplies";
import type { SupplyProduct } from "../../../types";

export function getStaticPaths() {
  return supplies.map((supply) => ({ params: { id: supply.id }, props: { supply } }));
}

interface Props { supply: SupplyProduct; }
const { supply } = Astro.props;
---
<BaseLayout title={`${supply.name} 상세정보 | ${company.name}`} description={supply.description} path={`/products/supply/${supply.id}`}>
  <section class="product-detail"><div class="container">
    <a class="product-detail__back" href="/products/supplies">← 소모품 목록</a>
    <div class="product-detail__hero">
      <ProductImageGallery images={[supply.image]} productName={supply.name} />
      <div class="product-detail__summary">
        <p class="service-content__eyebrow">SINDOH SUPPLIES · {supply.model}</p>
        <h1>{supply.name}</h1>
        <p class="product-detail__lead">{supply.description}</p>
        <p class="product-detail__price">{supply.price}</p>
        <div class="hero__actions"><a class="button" href="/contact">상품 문의하기</a><a class="button button--secondary" href="tel:028270050">전화 상담</a></div>
      </div>
    </div>
    <div class="product-detail__grid">
      <section class="product-detail__section"><p class="section-heading__eyebrow">PRODUCT DETAILS</p><h2>상품 정보</h2><dl class="spec-table"><div><dt>사용 모델</dt><dd>{supply.model}</dd></div><div><dt>상품 구분</dt><dd>{supply.kind} · {supply.format}</dd></div><div><dt>토너 코드</dt><dd>{supply.cartridge}</dd></div><div><dt>사용 가능 매수</dt><dd>{supply.spec}</dd></div><div><dt>색상</dt><dd>{supply.color ?? "검정·파랑·빨강·노랑"}</dd></div></dl></section>
      <section class="product-detail__section"><p class="section-heading__eyebrow">NOTICE</p><h2>구매 전 확인</h2><ul class="product-detail__features"><li>주문 전 사용 중인 복합기 모델과 토너 코드를 확인해 주세요.</li><li>재생 토너는 제조·유통 과정에 따라 외관이 달라질 수 있습니다.</li><li>재고와 배송 가능 여부는 상담을 통해 안내해 드립니다.</li></ul></section>
    </div>
  </div></section>
</BaseLayout>
