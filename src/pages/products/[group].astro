---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import SidebarPanel from "../../components/SidebarPanel.astro";
import { company, sidebarItems } from "../../data/company";
import { visibleProducts } from "../../data/products";

const groupMeta = {
  rental: {
    title: "렌탈임대 제품",
    description: "",
    activeKey: "rental"
  },
  multifunction: {
    title: "복합기 구매 제품",
    description: "",
    activeKey: "multifunction"
  },
  printer: {
    title: "프린터 구매 제품",
    description: "",
    activeKey: "printer"
  },
  supplies: {
    title: "소모품",
    description: "",
    activeKey: "supplies"
  },
  shredder: {
    title: "문서세단기",
    description: "",
    activeKey: "shredder"
  },
  "kyocera-bw-mfp": {
    title: "교세라 흑백복합기",
    description: "",
    activeKey: "kyocera-bw-mfp"
  },
  "kyocera-color-mfp": {
    title: "교세라 컬러복합기",
    description: "",
    activeKey: "kyocera-color-mfp"
  },
  "kyocera-color-printer": {
    title: "교세라 컬러프린터",
    description: "",
    activeKey: "kyocera-color-printer"
  },
  "kyocera-bw-printer": {
    title: "교세라 흑백프린터",
    description: "",
    activeKey: "kyocera-bw-printer"
  }
} as const;

export function getStaticPaths() {
  return [
    { params: { group: "rental" } },
    { params: { group: "multifunction" } },
    { params: { group: "printer" } },
    { params: { group: "supplies" } },
    { params: { group: "shredder" } },
    { params: { group: "kyocera-bw-mfp" } },
    { params: { group: "kyocera-color-mfp" } },
    { params: { group: "kyocera-color-printer" } },
    { params: { group: "kyocera-bw-printer" } }
  ];
}

const group = Astro.params.group as keyof typeof groupMeta;
const meta = groupMeta[group];
const activeKey = meta.activeKey;
const filteredProducts = visibleProducts.filter((product) => product.listingGroup === group);
---

<BaseLayout
  title={`${company.name} | ${meta.title}`}
  description={meta.description}
  path={`/products/${group}`}
>
  <section class="service-page">
    <div class="container service-page__grid">
      <SidebarPanel activeKey={meta.activeKey} />

      <div class="service-content">
        <div class="product-shell">
          <div class="product-shell__hero">
            <div>
              <p class="service-content__eyebrow">PRODUCT DIRECTORY</p>
              <h1>{meta.title}</h1>
              <p class="product-shell__summary">{meta.description}</p>
            </div>
            <div class="product-shell__meta">
              <span>{activeKey === "supplies" ? "소모품 카테고리" : `${filteredProducts.length}개 제품`}</span>
              <a href="/products">전체 제품목록 보기</a>
            </div>
          </div>

          {activeKey.startsWith("kyocera-") && (
            <nav class="product-category-tabs" aria-label="교세라 제품 분류">
              <a class:list={[activeKey === "kyocera-color-mfp" && "is-active"]} href="/products/kyocera-color-mfp">컬러복합기</a>
              <a class:list={[activeKey === "kyocera-color-printer" && "is-active"]} href="/products/kyocera-color-printer">컬러프린터</a>
              <a class:list={[activeKey === "kyocera-bw-mfp" && "is-active"]} href="/products/kyocera-bw-mfp">흑백복합기</a>
              <a class:list={[activeKey === "kyocera-bw-printer" && "is-active"]} href="/products/kyocera-bw-printer">흑백프린터</a>
            </nav>
          )}

          {activeKey === "supplies" && (
            <section class="supplies-categories" aria-label="소모품 브랜드 및 제품 분류">
              <nav class="supplies-brand-tabs" aria-label="소모품 브랜드">
                <button class="is-active" type="button" data-supplies-brand="sindoh" aria-controls="supplies-sindoh" aria-selected="true">신도</button>
                <button type="button" data-supplies-brand="kyocera" aria-controls="supplies-kyocera" aria-selected="false">교세라</button>
              </nav>

              <div class="supplies-category-panel is-active" id="supplies-sindoh" data-supplies-panel="sindoh">
                <p class="supplies-category-panel__label">신도 소모품</p>
                <div class="supplies-subcategory-grid">
                  <a href="#supplies-sindoh-d450">D450</a>
                  <a href="#supplies-sindoh-d320">D320</a>
                  <a href="#supplies-sindoh-d470">D470</a>
                </div>
              </div>

              <div class="supplies-category-panel" id="supplies-kyocera" data-supplies-panel="kyocera" hidden>
                <p class="supplies-category-panel__label">교세라 소모품</p>
                <div class="supplies-product-group">
                  <h2>복합기</h2>
                  <div class="supplies-subcategory-grid supplies-subcategory-grid--three">
                    <a href="#supplies-kyocera-taskalfa-2554cig">TASKalfa 2554ciG</a>
                    <a href="#supplies-kyocera-taskalfa-3554cig">TASKalfa 3554ciG</a>
                    <a href="#supplies-kyocera-taskalfa-4054cig">TASKalfa 4054ciG</a>
                    <a href="#supplies-kyocera-taskalfa-mz3200i">TASKalfa MZ3200i</a>
                    <a href="#supplies-kyocera-taskalfa-mz4000i">TASKalfa MZ4000i</a>
                    <a href="#supplies-kyocera-ecosys-ma3500cifx">ECOSYS MA3500cifx</a>
                  </div>
                </div>
                <div class="supplies-product-group">
                  <h2>프린터</h2>
                  <div class="supplies-subcategory-grid supplies-subcategory-grid--one">
                    <a href="#supplies-kyocera-ecosys-pa3500cx">ECOSYS PA3500cx</a>
                  </div>
                </div>
              </div>
              <p class="supplies-category-note">제품을 선택하면 해당 모델의 소모품을 추가할 수 있습니다.</p>
            </section>
          )}

          {activeKey !== "supplies" && <div class="product-grid">
            {filteredProducts.map((product) => <ProductCard product={product} />)}
          </div>}
          {activeKey !== "supplies" && filteredProducts.length === 0 && (
            <div class="product-empty">
              <strong>제품을 준비하고 있습니다.</strong>
              <p>원하시는 모델이나 설치 환경을 알려주시면 먼저 상담해드리겠습니다.</p>
              <a class="button button--secondary" href="/contact">제품 문의하기</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

{activeKey === "supplies" && (
  <script>
    const brandButtons = document.querySelectorAll<HTMLButtonElement>("[data-supplies-brand]");
    const brandPanels = document.querySelectorAll<HTMLElement>("[data-supplies-panel]");

    brandButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const brand = button.dataset.suppliesBrand;
        brandButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });
        brandPanels.forEach((panel) => {
          const isActive = panel.dataset.suppliesPanel === brand;
          panel.classList.toggle("is-active", isActive);
          panel.hidden = !isActive;
        });
      });
    });
  </script>
)}
