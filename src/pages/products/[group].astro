---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import SidebarPanel from "../../components/SidebarPanel.astro";
import { company, sidebarItems } from "../../data/company";
import { visibleProducts } from "../../data/products";

const groupMeta = {
  rental: {
    title: "렌탈임대 제품",
    description: "임대상품과 렌탈 제품만 모아 빠르게 비교할 수 있도록 구성했습니다.",
    activeKey: "rental"
  },
  multifunction: {
    title: "복합기 구매 제품",
    description: "복합기 구매가 필요한 고객을 위해 복합기 제품만 모아 보여줍니다.",
    activeKey: "multifunction"
  },
  printer: {
    title: "프린터 구매 제품",
    description: "프린터 구매가 필요한 고객을 위해 프린터 제품만 따로 정리했습니다.",
    activeKey: "printer"
  },
  supplies: {
    title: "소모품",
    description: "운영에 필요한 소모품만 따로 확인할 수 있게 구성했습니다.",
    activeKey: "supplies"
  }
} as const;

export function getStaticPaths() {
  return [
    { params: { group: "rental" } },
    { params: { group: "multifunction" } },
    { params: { group: "printer" } },
    { params: { group: "supplies" } }
  ];
}

const group = Astro.params.group as keyof typeof groupMeta;
const meta = groupMeta[group];
const filteredProducts = visibleProducts.filter((product) => product.listingGroup === group);
---

<BaseLayout
  title={`${company.name} | ${meta.title}`}
  description={meta.description}
  path={`/products/${group}`}
>
  <section class="service-page">
    <div class="container service-page__grid">
      <SidebarPanel activeKey={meta.activeKey} />

      <div class="service-content">
        <div class="product-shell">
          <div class="product-shell__hero">
            <div>
              <p class="service-content__eyebrow">PRODUCT DIRECTORY</p>
              <h1>{meta.title}</h1>
              <p class="product-shell__summary">{meta.description}</p>
            </div>
            <div class="product-shell__meta">
              <span>{filteredProducts.length}개 제품</span>
              <a href="/products">전체 제품목록 보기</a>
            </div>
          </div>

          <div class="product-grid">
            {filteredProducts.map((product) => <ProductCard product={product} />)}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
