---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { company } from "../data/company";
---
<BaseLayout title={`${company.name} | 회사소개`} description={company.description} path="/company">
  <section class="page-hero"><div class="container page-hero__inner"><p class="page-hero__eyebrow">COMPANY</p><h1>신도클라우드</h1><p>{company.description}</p></div></section>
  <section class="section"><div class="container">
    <div class="feature-grid">{company.categories.map((item) => <article class="feature-card"><h3>{item.name}</h3><p>{item.description}</p></article>)}</div>
  </div></section>
  <section class="section section--soft"><div class="container info-ribbon">
    <div><p class="info-ribbon__label">Address</p><strong>{company.address}</strong></div>
    <div><p class="info-ribbon__label">Phone</p><strong>{company.phone}</strong></div>
    <div><p class="info-ribbon__label">Business</p><strong>{company.businessInfo}</strong></div>
  </div></section>
  <div class="container section"><ContactPanel /></div>
</BaseLayout>
