---
import type { Product } from "../types";
interface Props { product: Product; }
const { product } = Astro.props;
const isSindoh = product.id.startsWith("sindoh-");
const isShredder = product.listingGroup === "shredder";
---
<a class:list={["product-card", { "product-card--sindoh": isSindoh, "product-card--shredder": isShredder }]} href={`/products/detail/${product.id}`} aria-label={`${product.name} 상세정보 보기`}>
  <div class="product-card__image-wrap">
    <img class="product-card__image" src={product.image} alt={`${product.name} 제품 이미지`} loading="lazy" width="640" height="420" />
    <span class="product-card__category">{product.category}</span>
  </div>
  <div class="product-card__body">
    <div class="product-card__header"><h3>{product.name}</h3><p class="product-card__price">{product.price}</p></div>
    <p class="product-card__spec">{product.spec}</p>
    <p class="product-card__description">{product.description}</p>
    <span class="button button--secondary">상세정보 보기</span>
  </div>
</a>
