---
import type { Product } from "../types";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const showcaseItems = products.flatMap((product) =>
  (product.gallery?.length ? product.gallery : [product.image])
    .slice(0, 3)
    .map((image, imageIndex) => ({
      image,
      imageIndex,
      product,
    }))
);
---

<section class="hero-catalog__feature" data-product-showcase aria-label="추천 복합기">
  {showcaseItems.length > 0 && (
    <div class="hero-showcase__viewport">
      <article class="hero-showcase__slide is-active">
        <header class="hero-showcase__header">
          <p class="hero-catalog__label">MFP LINEUP</p>
          <h2>사무환경에 맞는 신도 복합기</h2>
          <p>출력량과 업무 방식에 따라 선택할 수 있도록 주요 복합기의 특징과 사양을 한눈에 안내해드립니다.</p>
        </header>
        <div class="hero-carousel" aria-live="off">
          {showcaseItems.map(({ image, imageIndex, product }, index) => (
            <img
              class:list={["hero-carousel__image", { "is-active": index === 0 }]}
              src={image}
              alt={`${product.name} 제품 이미지 ${imageIndex + 1}`}
              width="640"
              height="420"
              loading={index === 0 ? "eager" : "lazy"}
              aria-hidden={index === 0 ? "false" : "true"}
              data-showcase-image
            />
          ))}
        </div>
      </article>
    </div>

    <div class="hero-showcase__controls" aria-label="제품 이미지 선택">
      <div class="hero-carousel__dots">
        {showcaseItems.map(({ imageIndex, product }, index) => (
          <button
            class:list={["hero-carousel__dot", { "is-active": index === 0 }]}
            type="button"
            data-showcase-dot
            aria-label={`${product.name} 이미지 ${imageIndex + 1} 보기`}
            aria-current={index === 0 ? "true" : "false"}
          />
        ))}
      </div>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-showcase]").forEach((showcase) => {
    const images = Array.from(showcase.querySelectorAll<HTMLImageElement>("[data-showcase-image]"));
    const dots = Array.from(showcase.querySelectorAll<HTMLButtonElement>("[data-showcase-dot]"));
    let activeIndex = 0;
    let autoplay: number | undefined;

    const showImage = (index: number) => {
      if (images.length === 0) return;
      activeIndex = (index + images.length) % images.length;

      images.forEach((image, imageIndex) => {
        const isActive = imageIndex === activeIndex;
        image.classList.toggle("is-active", isActive);
        image.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("is-active", isActive);
        dot.setAttribute("aria-current", String(isActive));
      });
    };

    const stopAutoplay = () => {
      if (autoplay !== undefined) window.clearInterval(autoplay);
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        autoplay = window.setInterval(() => showImage(activeIndex + 1), 3000);
      }
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      showImage(index);
      startAutoplay();
    }));

    showcase.addEventListener("mouseenter", stopAutoplay);
    showcase.addEventListener("mouseleave", startAutoplay);
    showcase.addEventListener("focusin", stopAutoplay);
    showcase.addEventListener("focusout", startAutoplay);
    startAutoplay();
  });
</script>
